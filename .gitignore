# ==========================================
# RedCheck API - .gitignore
# ==========================================

# 1. Compiled class files
*.class

# 2. Log files
*.log

# 3. Maven (Build directory)
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# 4. IntelliJ IDEA (Local IDE configuration files)
.idea/
*.iws
*.iml
*.ipr
out/

# 5. VS Code / Eclipse (In case someone else touches the code in the future)
.vscode/
.classpath
.project
.settings/

# 6. Packaged files
*.jar
*.war
*.ear
*.zip
*.tar.gz

# 7. OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# 8. Environment variables and local secrets (CRITICAL!)
.env
.env.local
application-local.yml
application-local.properties